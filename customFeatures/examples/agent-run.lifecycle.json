            "queued",
            "planning",
            "executing",
            "reviewing",
            "completed"
          ],
          "state": [
            "main rail"
          ]
        },
        {
          "id": "approval",
          "title": "Executing can pause for a human",
          "body": "If the run needs approval it leaves the rail and waits. A refused approval **cancels** the run; it does not silently resume.",
          "notes": [
            {
              "title": "Waiting is a state, not a hang",
              "body": "Modelling it explicitly is what lets the UI show who is holding the run up."
            }
