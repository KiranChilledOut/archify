  ],
  "edges": [
    {
      "id": "request-chat",
      "from": "user",
      "to": "chat",
      "variant": "default"
    },
    {
      "id": "plan-request",
      "from": "chat",
      "to": "planner",
      "label": "plan",
      "variant": "emphasis"
    },
    {
      "id": "planner-route",
      "from": "planner",
      "to": "router",
      "variant": "default"
    },
