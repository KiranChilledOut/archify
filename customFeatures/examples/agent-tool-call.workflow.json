      "role": "return",
      "fromSide": "right",
      "toSide": "right",
      "route": "outside-right",
      "width": 1.2
    },
    {
      "id": "record-result",
      "from": "external",
      "to": "trace",
      "label": "record result",
      "variant": "dashed",
      "fromSide": "bottom",
      "toSide": "bottom",
      "route": "bottom-channel",
      "labelSegment": 1
    },
